# Copy to backend/.env only for a deployment that supports a private env file.
# Prefer PrimeCloud's secret manager/environment settings for production.
APP_ENV=production
DATABASE_URL=mysql+pymysql://<user>:<password>@<mysql-host>:3306/<database>
CORS_ORIGINS=https://<your-vercel-project>.vercel.app
JENGA_SECRET_KEY=replace-with-a-long-random-production-secret
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
PORT=8080
